<section class="timeline-notes-sidebar__content">
  <header class="timeline-notes-toolbar">
    <div class="timeline-notes-toolbar__buttons">
      <button type="button" data-action="create-note" title="{{localize "TIMELINE_NOTES.Action.Create"}}">
        <i class="fa-solid fa-plus"></i>
      </button>
      <button type="button" data-action="jump-date" title="{{localize "TIMELINE_NOTES.Action.JumpDate"}}">
        <i class="fa-solid fa-calendar-days"></i>
      </button>
      {{#if isGM}}
        <button type="button" data-action="set-campaign-time" title="{{localize "TIMELINE_NOTES.Action.SetCampaignTime"}}">
          <i class="fa-solid fa-clock"></i>
        </button>
      {{/if}}
      <button type="button" data-action="toggle-order" title="{{orderLabel}}">
        <i class="fa-solid fa-arrow-down-wide-short"></i>
      </button>
    </div>
    <div class="timeline-notes-toolbar__search">
      <input type="search" name="query" value="{{query}}" placeholder="{{localize "TIMELINE_NOTES.Action.Filter"}}">
      <button type="button" data-action="toggle-tag-filter" title="{{localize "TIMELINE_NOTES.Action.FilterTags"}}" class="{{#if selectedTags.length}}timeline-notes-toolbar__filter-active{{/if}}">
        <i class="fa-solid fa-tags"></i>
      </button>
      <div class="timeline-notes-tag-filter" hidden>
        {{#if allTags.length}}
          {{#each allTags}}
            <label class="timeline-notes-tag-filter__option">
              <input type="checkbox" name="tagFilter" value="{{id}}" {{#if selected}}checked{{/if}}>
              <span class="timeline-notes-tag-filter__swatch" style="background:{{color}}"></span>
              <span>{{name}}</span>
            </label>
          {{/each}}
        {{else}}
          <p class="timeline-notes-tag-filter__empty">{{localize "TIMELINE_NOTES.TagFilter.Empty"}}</p>
        {{/if}}
      </div>
    </div>
    <p>{{currentDateTime}}</p>
  </header>

  <main class="timeline-notes-list">
    {{#if hasNotes}}
      {{#each groups}}
        <section class="timeline-notes-year">
          <h2>{{year}}</h2>
          {{#each months}}
            <section class="timeline-notes-month">
              {{#if ../showMonthHeaders}}<h3>{{label}}</h3>{{/if}}
              {{#each days}}
                <section class="timeline-notes-day">
                  {{#if ../showDayHeaders}}<h4>{{day}}</h4>{{/if}}
                  {{#each notes}}
                    <article class="timeline-notes-card" data-action="open-note" data-note-id="{{id}}" data-entry-type="{{entryType}}">
                      <div class="timeline-notes-card__authorline{{#unless canEdit}} timeline-notes-card__authorline--split{{/unless}}" style="--author-color:{{authorBar.color}}"></div>
                      <div class="timeline-notes-card__content">
                        <header>
                          <time>{{dateTime}}</time>
                          {{#if entryTypeLabel}}
                            <span class="timeline-notes-card__marker timeline-notes-card__marker--{{entryType}}">{{entryTypeLabel}}</span>
                          {{/if}}
                          <span class="timeline-notes-card__title">{{name}}</span>
                        </header>
                        <p class="timeline-notes-card__preview">{{preview}}</p>
                      </div>
                      <div class="timeline-notes-card__tagstack">
                        {{#each resolvedTags}}
                          <span class="timeline-notes-card__tagline" style="background:{{color}}" title="{{name}}"></span>
                        {{/each}}
                      </div>
                    </article>
                  {{/each}}
                </section>
              {{/each}}
            </section>
          {{/each}}
        </section>
      {{/each}}
    {{else}}
      <p class="timeline-notes-empty">{{localize "TIMELINE_NOTES.EmptyTimeline"}}</p>
    {{/if}}
  </main>
</section>
